{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ES2022",
    "skipLibCheck": true,
    "strictNullChecks": true,

    "paths": {
      "@printdesk/core/*": ["../core/src/*"],
      "@printdesk/ui/*": ["../ui/src/components/*"],
      "@printdesk/ui/styles/*": ["../ui/src/styles/*"]
    },

    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": false
      }
    ]
  }
}
